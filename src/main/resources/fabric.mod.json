{
  "schemaVersion": 1,
  "id": "gwoodworks",
  "name": "guita's Woodworks",
  "version": "${version}",
  "authors": [
    {
      "name": "macuguita",
      "contact": {
        "homepage": "https://macuguita.com"
      }
    }
  ],
  "contact": {
    "sources": "https://github.com/macuguita/woodworks",
    "issues": "https://github.com/macuguita/woodworks/issues"
  },
  "description": "Decorations that have some sort of chopped charm!",
  "icon": "assets/gwoodworks/logo.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.macuguita.woodworks.fabric.FabricEntrypoint"
    ],
    "client": [
      "com.macuguita.woodworks.fabric.FabricClientEntrypoint"
    ],
    "fabric-datagen": [
      "com.macuguita.woodworks.fabric.datagen.FabricDataGeneratorEntrypoint"
    ]
  },
  "mixins": [
    "gwoodworks.mixins.json"
  ],
  "accessWidener": "gwoodworks.classtweaker",
  "depends": {
    "fabric-api": "*",
    "macu_lib": "${macu_lib_ver}"
  },
  "custom": {
    "modmenu": {
      "update_checker": true,
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/guitas-woodworks",
        "modmenu.modrinth": "https://modrinth.com/mod/guitas-woodworks"
      }
    }
  }
}
